{
  "$schema": "./package.schema.json",
  "name": "effective-modules",
  "version": "0.3.5",
  "license": "MIT",
  "description": "A more ergonomic way to write Effective code",
  "type": "module",
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test src",
    "jive:cicd:deploy:url": "jive-library cicd deploy-url",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "build:local": "bun ../jive-abstract-library/src/entrypoints/jive-library.ts cicd build",
    "deploy:local": "JIVE_DEPLOY_ENVIRONMENT=local JIVE_PIPELINE_CONTEXT='{\"provider\": \"Github\", \"repository\": {\"owner\": \"ozyman42\", \"name\": \"effective-modules\"}, \"sourceBranch\": \"local\", \"sourceCommitSha\": \"\", \"event\": {\"type\": \"DIRECT_WORKFLOW_RUN\"}}' bun ../jive-abstract-library/src/entrypoints/jive-library.ts cicd deploy",
    "test": "bun test src",
    "prepare": "[ \"$CI\" = \"true\" ] || lefthook install"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest"
    },
    "library": {
      "daemons": []
    }
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "effect": "^4.0.0",
    "lefthook": "latest",
    "typescript": "^5.9.3",
    "jive-abstract-library": "0.1.2"
  }
}
